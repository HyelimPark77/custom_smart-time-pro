<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/root_view" android:background="@color/view_page_main_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:textColor="@color/text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择写入类型" />
        <Spinner android:id="@id/spinner_write_type" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:textColor="@color/text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5.0dp" android:text="如果填写了imei/sn，app将批量反写这个信息" />
        <EditText android:textColor="@color/text_color" android:gravity="center" android:id="@id/et_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="imei/sn" />
        <EditText android:textColor="@color/text_color" android:textColorHint="@color/text_color" android:id="@id/et_old_ble_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5.0dp" android:hint="@string/click_search_hint" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:textColor="@color/text_color" android:textColorHint="@color/text_color" android:id="@id/et_signal" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="100" android:layout_weight="1.0" android:inputType="number" />
            <androidx.appcompat.widget.AppCompatButton android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="@string/click_search_signal_hint" android:layout_weight="2.0" android:onClick="startSearch" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textColor="@color/text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_signal_hint" />
                <TextView android:textColor="@color/text_color" android:id="@id/tv_search_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10.0dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textColor="@color/text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记录：" />
                <TextView android:textColor="@color/text_color" android:id="@id/tv_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10.0dp" />
            </LinearLayout>
        </LinearLayout>
        <ListView android:id="@id/list_view" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="100.0dp" android:divider="@null" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dp" android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatButton android:id="@id/bt_start_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="确认以上搜索结果正确,开始针对该系列设备进行循环设置" android:onClick="startSet" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@id/bt_stop_set" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="停止操作" android:onClick="stopSet" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@id/bt_clear_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清除记录" android:onClick="clearHistory" android:textAllCaps="false" />
    </LinearLayout>
</RelativeLayout>
