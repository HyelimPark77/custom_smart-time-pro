<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/empty_panel" android:background="@drawable/v2_status_item_ecg_bg" style="@style/status_card_style">
        <com.sma.smartv3.view.text.PFMedium android:text="@string/electrocardiogram" style="@style/status_card_style_1_title" />
        <com.sma.smartv3.view.text.PFMedium android:id="@id/tv_no_data" style="@style/status_card_style_no_data" />
        <com.sma.smartv3.view.TintImageView android:layout_gravity="end" android:src="@drawable/icon_status_ecg" style="@style/status_card_style_2_iv" />
    </LinearLayout>
    <LinearLayout android:id="@id/data_panel" android:visibility="gone" style="@style/status_card_style">
        <com.sma.smartv3.view.text.PFMedium android:text="@string/heart_rate" style="@style/status_card_style_1_title" />
        <RelativeLayout style="@style/status_card_style_1">
            <LinearLayout style="@style/status_card_style_1_ll">
                <LinearLayout android:id="@id/ll_value" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <com.sma.smartv3.view.text.MHFont android:id="@id/hrLastValue" android:text="122" style="@style/status_card_style_1_content" />
                    <com.sma.smartv3.view.text.PFRegular android:text="@string/bpm" style="@style/unit_style" />
                </LinearLayout>
                <com.sma.smartv3.view.text.DINCondBold android:id="@id/hrLastTime" android:text="10.23" style="@style/status_card_style_1_time" />
            </LinearLayout>
            <com.sma.smartv3.view.TintImageView android:id="@id/hrIv" android:src="@drawable/icon_ecg" style="@style/status_card_style_1_iv" />
        </RelativeLayout>
        <LinearLayout style="@style/status_item_chart_rl_style">
            <com.github.mikephil.charting.charts.LineChart android:id="@id/hrLineChart" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" />
            <com.sma.smartv3.view.text.PFMedium android:id="@id/tv_chart_bottom_text" android:text="@string/last_few_hours" style="@style/status_card_style_bottom_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
