<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.github.mikephil.charting.charts.LineChart android:id="@id/line_chart" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatButton android:id="@id/btn_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start" android:layout_weight="1.0" android:onClick="toggle" />
            <androidx.appcompat.widget.AppCompatButton android:id="@id/btn_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Share" android:layout_weight="1.0" android:onClick="share" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginBottom="60.0dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10.0dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@id/btn_clear" android:layout_width="wrap_content" android:layout_height="40.0dp" android:text="Clear" android:layout_weight="1.0" android:onClick="clear" />
            <androidx.appcompat.widget.AppCompatButton android:id="@id/btn_copy" android:layout_width="wrap_content" android:layout_height="40.0dp" android:text="Copy" android:layout_weight="1.0" android:onClick="copy" />
        </LinearLayout>
        <TextView android:id="@id/tv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@id/tv_info" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
