<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/root_view" android:background="@color/view_page_main_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical" android:paddingTop="10.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp">
            <TextView android:id="@id/tv_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/select_file_hint" />
            <androidx.appcompat.widget.AppCompatButton android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/select_internal_file" android:onClick="chooseAssetFile" />
            <androidx.appcompat.widget.AppCompatButton android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/select_sd_file" android:onClick="chooseFile" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp">
            <EditText android:textColor="@color/text_color" android:textColorHint="@color/text_color" android:id="@id/et_signal" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="60" android:layout_weight="1.0" android:inputType="number" />
            <androidx.appcompat.widget.AppCompatButton android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="@string/click_search_signal_hint" android:layout_weight="2.0" android:onClick="startSearch" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp">> 
            <TextView android:textColor="@color/text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/click_search_hint" />
        </LinearLayout>
        <ListView android:id="@id/list_view" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" />
    </LinearLayout>
</RelativeLayout>
