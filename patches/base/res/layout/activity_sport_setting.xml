<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/view_page_main_bg" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/layout_title_iv_tv_iv" />
    <LinearLayout android:id="@id/llVoiceBroadcast" android:visibility="gone" style="@style/sport_set_ll_style">
        <View style="@style/line_sport_set" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.sma.smartv3.view.text.PFMedium android:text="@string/sport_setting_voice_broadcast" style="@style/sport_set_ll_tv" />
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@id/voiceBroadcastCB" style="@style/sport_set_ll_cb" />
        </RelativeLayout>
        <com.sma.smartv3.view.text.PFMedium android:textSize="12.0sp" android:layout_marginTop="0.0dp" android:text="@string/sport_setting_voice_broadcast_info" style="@style/sport_set_ll_tv" />
        <View style="@style/line_sport_set" />
    </LinearLayout>
    <LinearLayout style="@style/sport_set_ll_style">
        <View style="@style/line_sport_set" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.sma.smartv3.view.text.PFMedium android:text="@string/the_screen_is_always_on" style="@style/sport_set_ll_tv" />
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@id/screenAlwaysOnCB" style="@style/sport_set_ll_cb" />
        </RelativeLayout>
        <View style="@style/line_sport_set" />
    </LinearLayout>
    <LinearLayout android:onClick="sportPermissionSetClick" style="@style/sport_set_ll_style">
        <View style="@style/line_sport_set" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.sma.smartv3.view.text.PFMedium android:text="@string/sports_permission_settings" style="@style/sport_set_ll_tv" />
            <ImageView android:layout_centerVertical="true" android:layout_alignParentEnd="true" style="@style/user_info_image" />
        </RelativeLayout>
        <View style="@style/line_sport_set" />
    </LinearLayout>
</LinearLayout>
