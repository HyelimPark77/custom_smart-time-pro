<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/progress_blue_bg_color" />
            <corners android:radius="2.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleHeight="0%" android:scaleGravity="start">
            <shape>
                <solid android:color="@color/progress_blue_color" />
                <corners android:radius="2.0dp" />
            </shape>
        </scale>
    </item>
</layer-list>
